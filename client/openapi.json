tion": "Forbidden", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProductHiddenError"}}}}}, "security": [{"JWTAuth": []}]}}}, "components": {"schemas": {"TokenObtainPairOutputSchema": {"properties": {"username": {"description": "Required. 150 characters or fewer. Letters, digits and @/./+/-/_ only.", "maxLength": 150, "title": "Username", "type": "string"}, "refresh": {"title": "Refresh", "type": "string"}, "access": {"title": "Access", "type": "string"}}, "required": ["username", "refresh", "access"], "title": "TokenObtainPairOutputSchema", "type": "object"}, "TokenObtainPairInputSchema": {"properties": {"password": {"format": "password", "title": "Password", "type": "string", "writeOnly": true}, "username": {"description": "Required. 150 characters or fewer. Letters, digits and @/./+/-/_ only.", "maxLength": 150, "title": "Username", "type": "string"}}, "required": ["password", "username"], "title": "TokenObtainPairInputSchema", "type": "object"}, "TokenRefreshOutputSchema": {"properties": {"refresh": {"title": "Refresh", "type": "string"}, "access": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Access"}}, "required": ["refresh", "access"], "title": "TokenRefreshOutputSchema", "type": "object"}, "TokenRefreshInputSchema": {"properties": {"refresh": {"title": "Refresh", "type": "string"}}, "required": ["refresh"], "title": "TokenRefreshInputSchema", "type": "object"}, "Schema": {"properties": {}, "title": "Schema", "type": "object"}, "TokenVerifyInputSchema": {"properties": {"token": {"title": "Token", "type": "string"}}, "required": ["token"], "title": "TokenVerifyInputSchema", "type": "object"}, "DraftPostSchema": {"properties": {"status": {"const": "DF", "title": "Status", "type": "string"}, "id": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "ID"}, "title": {"maxLength": 250, "title": "Title", "type": "string"}, "slug": {"maxLength": 250, "title": "Slug", "type": "string"}, "updated": {"format": "date-time", "title": "Updated", "type": "string"}}, "required": ["status", "title", "slug", "updated"], "title": "DraftPostSchema", "type": "object"}, "PublishedPostSchema": {"properties": {"status": {"const": "PB", "title": "Status", "type": "string"}, "id": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "ID"}, "title": {"maxLength": 250, "title": "Title", "type": "string"}, "slug": {"maxLength": 250, "title": "Slug", "type": "string"}, "body": {"title": "Body", "type": "string"}, "publish": {"format": "date-time", "title": "Publish", "type": "string"}}, "required": ["status", "title", "slug", "body"], "title": "PublishedPostSchema", "type": "object"}, "PostNotFoundError": {"properties": {"tag": {"const": "post_not_found", "title": "Tag", "type": "string"}, "detail": {"title": "Detail", "type": "string"}, "id": {"title": "Id", "type": "integer"}}, "required": ["tag", "detail", "id"], "title": "PostNotFoundError", "type": "object"}, "AvailableProductSchema": {"description": "Available product — has stock_count. tag maps from ORM's status field.", "properties": {"tag": {"const": "available", "title": "Tag", "type": "string"}, "id": {"title": "Id", "type": "integer"}, "name": {"title": "Name", "type": "string"}, "description": {"title": "Description", "type": "string"}, "price": {"pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$", "title": "Price", "type": "string"}, "stock_count": {"title": "Stock Count", "type": "integer"}}, "required": ["tag", "id", "name", "description", "price", "stock_count"], "title": "AvailableProductSchema", "type": "object"}, "OutOfStockProductSchema": {"description": "Out-of-stock product — no stock_count. tag maps from ORM's status field.", "properties": {"tag": {"const": "out_of_stock", "title": "Tag", "type": "string"}, "id": {"title": "Id", "type": "integer"}, "name": {"title": "Name", "type": "string"}, "description": {"title": "Description", "type": "string"}, "price": {"pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$", "title": "Price", "type": "string"}}, "required": ["tag", "id", "name", "description", "price"], "title": "OutOfStockProductSchema", "type": "object"}, "ProductNotFoundError": {"properties": {"tag": {"const": "product_not_found", "title": "Tag", "type": "string"}, "detail": {"title": "Detail", "type": "string"}, "id": {"title": "Id", "type": "integer"}}, "required": ["tag", "detail", "id"], "title": "ProductNotFoundError", "type": "object"}, "ProductHiddenError": {"properties": {"tag": {"const": "product_hidden", "title": "Tag", "type": "string"}, "detail": {"title": "Detail", "type": "string"}, "id": {"title": "Id", "type": "integer"}}, "required": ["tag", "detail", "id"], "title": "ProductHiddenError", "type": "object"}}, "securitySchemes": {"JWTAuth": {"type": "http", "scheme": "bearer"}}}, "servers": []}
